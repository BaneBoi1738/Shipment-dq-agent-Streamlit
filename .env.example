# --- Slack (incoming webhooks) ---
SLACK_WEBHOOK_URL=
# Optional routed channels (see routing in config)
SLACK_WEBHOOK_DATA_OPS=
SLACK_WEBHOOK_CARRIER_OPS=
SLACK_WEBHOOK_ONCALL=

# --- Google Sheets source ---
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=
# Either a path to the key file...
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# ...or the JSON content itself (handy for CI secrets)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Optional LLM fallback for column mapping ---
ANTHROPIC_API_KEY=
DQ_LLM_MODEL=claude-sonnet-5-5
